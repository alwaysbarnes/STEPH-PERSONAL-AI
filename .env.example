# STEPH Personal AI Assistant - Environment Configuration
# Supported providers: gemini, groq, openai, anthropic, openrouter

AI_PROVIDER=gemini
PORT=3000

# Google Gemini API Key (Recommended - Get free at https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq API Key (Ultrafast inference - Get free at https://console.groq.com/)
GROQ_API_KEY=

# OpenAI API Key (Optional - https://platform.openai.com/)
OPENAI_API_KEY=

# Anthropic Claude API Key (Optional - https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# OpenRouter API Key (Optional - https://openrouter.ai/)
OPENROUTER_API_KEY=
